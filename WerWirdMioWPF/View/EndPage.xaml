<Page x:Class="WerWirdMioWPF.View.EndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WerWirdMioWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="{x:Static SystemParameters.FullPrimaryScreenHeight}" d:DesignWidth="{x:Static SystemParameters.FullPrimaryScreenWidth}"
      Title="EndPage">

    <Grid>
        <MediaElement x:Name="BackgroundVideo"
              LoadedBehavior="Manual" 
              UnloadedBehavior="Stop"
              Stretch="UniformToFill"
              IsMuted="True" 
              MediaEnded="BackgroundVideo_MediaEnded" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DU BIST DER TIKI MEISTER!" 
                       FontSize="72" 
                       Foreground="Gold" 
                       FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>