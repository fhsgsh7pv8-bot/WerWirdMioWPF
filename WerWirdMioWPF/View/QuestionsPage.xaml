<Page x:Class="WerWirdMioWPF.View.QuestionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WerWirdMioWPF.View"
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel"
      d:DataContext="{d:DesignInstance Type=viewmodel:QuestionsPageViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="QuestionsPage">

    <Page.Resources>
        <Style x:Key="WoodenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE066"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontFamily" Value="Impact"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot">
                            <Image x:Name="BtnImage" Source="/images/antworttafel.png" Stretch="Fill">
                                <Image.Effect>
                                    <DropShadowEffect x:Name="GlowEffect" BlurRadius="0" ShadowDepth="0" Color="#FFD700" Opacity="0"/>
                                </Image.Effect>
                            </Image>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="45,10">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="1" ShadowDepth="2" Color="Black" Opacity="0.7"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnImage" Storyboard.TargetProperty="(Image.Effect).(DropShadowEffect.BlurRadius)" To="35" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnImage" Storyboard.TargetProperty="(Image.Effect).(DropShadowEffect.Opacity)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnImage" Storyboard.TargetProperty="(Image.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnImage" Storyboard.TargetProperty="(Image.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnImage" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="JokerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="JokerRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="JokerRoot" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="JokerRoot" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="JokerRoot" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="JokerRoot" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Image Source="/images/Tikiland.png" Stretch="UniformToFill" />

        <Grid Margin="60,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.8*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,30" CornerRadius="15" Padding="45,15" BorderThickness="4">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8B4513" Offset="0.0"/>
                            <GradientStop Color="#D2B48C" Offset="0.5"/>
                            <GradientStop Color="#5D2E0A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FFB347" Offset="0"/>
                            <GradientStop Color="#CC7A00" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗿 " FontSize="30" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPrizeDisplay}" FontSize="36" FontWeight="ExtraBold" Foreground="#3D1F00" FontFamily="Impact" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="#FFD700" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="20">
                    <Image Source="/images/fragetafel.png" Stretch="Fill" />
                    <TextBlock Text="{Binding CurrentQuestionText}" 
                               FontSize="42" 
                               FontFamily="Impact"
                               Foreground="#FFF5E1" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               TextAlignment="Center" 
                               Margin="110,60">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="3" Color="#222" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <UniformGrid Grid.Row="2" Rows="2" Columns="2" Margin="10">
                    <Button Content="{Binding Answer1Text}" Command="{Binding AnswerCommand}" CommandParameter="1" Style="{StaticResource WoodenButtonStyle}" Margin="15,10"/>
                    <Button Content="{Binding Answer2Text}" Command="{Binding AnswerCommand}" CommandParameter="2" Style="{StaticResource WoodenButtonStyle}" Margin="15,10"/>
                    <Button Content="{Binding Answer3Text}" Command="{Binding AnswerCommand}" CommandParameter="3" Style="{StaticResource WoodenButtonStyle}" Margin="15,10"/>
                    <Button Content="{Binding Answer4Text}" Command="{Binding AnswerCommand}" CommandParameter="4" Style="{StaticResource WoodenButtonStyle}" Margin="15,10"/>
                </UniformGrid>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">

                <Button Style="{StaticResource JokerButtonStyle}" Command="{Binding SelectJokerCommand}" CommandParameter="50-50-Joker" Margin="0,0,0,60">
                    <Image Source="/images/50joker.png" Stretch="Uniform" Height="233" Margin="0,0,-10,0">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                </Button>

                <Button Style="{StaticResource JokerButtonStyle}" Command="{Binding SelectJokerCommand}" CommandParameter="Danielaffe-Joker">
                    <Image Source="/images/affenjoker.png" Stretch="Uniform" Height="252" Width="378">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>