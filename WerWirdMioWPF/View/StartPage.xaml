<Page x:Class="WerWirdMioWPF.View.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=viewmodel:StartPageViewModel}"
      d:DesignHeight="1080" d:DesignWidth="1920">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">

            <Grid Width="800" Height="700" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,380,0,0">
                <Image Source="/images/startpage.png" Stretch="Uniform" RenderTransformOrigin="0.489,0.511" Margin="-102,-258,-102,-143" />

                <Grid Margin="0,280,0,100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="42" 
                             FontWeight="Bold"
                             Foreground="#FFE0B3"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             CaretBrush="White" Margin="158,34,168,10"/>

                    <Grid Grid.Row="1" Width="285" HorizontalAlignment="Center" Margin="0,50,0,50" Grid.RowSpan="2">
                        <Border x:Name="LoginGlow"
                                Background="#FFFFD54F"
                                CornerRadius="25"
                                Opacity="0"
                                IsHitTestVisible="False" Margin="-5,10,5,10">
                            <Border.Effect>
                                <BlurEffect Radius="30"/>
                            </Border.Effect>
                        </Border>

                        <Button Command="{Binding SetUserNameCommand}"
                                Content="STARTEN"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="Transparent" 
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand" Margin="-27,10,5,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LoginGlow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LoginGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Page>