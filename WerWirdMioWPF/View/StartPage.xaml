<Page x:Class="WerWirdMioWPF.View.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=viewmodel:StartPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="920">

    <!-- Insel-Hintergrund ist bereits im MainWindow -->

    <Grid>

        <!-- ZENTRIERTES SCHILD -->
        <Grid Width="650"
              Height="360"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- 🪵 SCHILD PNG -->
            <Image Source="/Images/schild.png"
                   Stretch="Uniform"
                   Margin="-99,136,-57,-127"/>
            

            <!-- ✨ LOGIN GLOW -->
            <Border x:Name="LoginGlow"
                    Width="119"
                    Height="44"
                    Background="#66FFD54F"
                    CornerRadius="22"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="294,0,0,0"
                    Opacity="0"
                    IsHitTestVisible="False">

                <Border.Effect>
                    <BlurEffect Radius="18"/>
                </Border.Effect>
            </Border>

            <!-- 🔘 UNSICHTBARER LOGIN BUTTON -->
            <Button Width="96"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Focusable="False"
                    Command="{Binding SetUserNameCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="275,355,0,0">

                <!-- Eigenes Template (kein WPF-Hover) -->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <!-- Skalierung -->
                <Button.RenderTransform>
                    <ScaleTransform x:Name="scale"
                                    ScaleX="1"
                                    ScaleY="1"/>
                </Button.RenderTransform>

                <!-- Hover steuert Glow + Scale -->
                <Button.Triggers>

                    <!-- MOUSE ENTER -->
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>

                                <!-- Glow ein -->
                                <DoubleAnimation Storyboard.TargetName="LoginGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.15"/>

                                <!-- Scale -->
                                <DoubleAnimation To="1.05"
                                                 Duration="0:0:0.1"
                                                 Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                <DoubleAnimation To="1.05"
                                                 Duration="0:0:0.1"
                                                 Storyboard.TargetProperty="RenderTransform.ScaleY"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <!-- MOUSE LEAVE -->
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>

                                <!-- Glow aus -->
                                <DoubleAnimation Storyboard.TargetName="LoginGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.15"/>

                                <!-- Scale zurück -->
                                <DoubleAnimation To="1"
                                                 Duration="0:0:0.1"
                                                 Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                <DoubleAnimation To="1"
                                                 Duration="0:0:0.1"
                                                 Storyboard.TargetProperty="RenderTransform.ScaleY"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                </Button.Triggers>

            </Button>

        </Grid>

    </Grid>

</Page>