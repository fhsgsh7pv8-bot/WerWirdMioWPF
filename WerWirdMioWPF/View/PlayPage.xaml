<Page x:Class="WerWirdMioWPF.View.PlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WerWirdMioWPF.View"  
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel" 
      d:DataContext="{d:DesignInstance Type=viewmodel:PlayPageViewModel}"
      mc:Ignorable="d" 
    d:DesignHeight="1080" d:DesignWidth="1920"
      Title="PlayPage">

    <Page.Resources>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Image Source="/images/tikiland.png" Stretch="UniformToFill" />

        <Image Source="/images/coconutgames.png" 
               Width="203" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" Margin="17,20,0,0" Height="209" />

        <Image Source="/images/Willkommen.png" 
               Width="280" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Margin="0,41,0,0" />

        <Label Content="{Binding UserName}" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Margin="0,260,0,0"
               FontSize="22" Foreground="Gold" FontWeight="Bold">
            <Label.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
            </Label.Effect>
        </Label>

        <Button Command="{Binding QuestionsPageCommand}"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0">
            <Image Source="/images/spielstarten.png" Width="320"/>
        </Button>

        <Button Command="{Binding ChangeUserCommand}"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,40">
            <Image Source="/images/benutzerwechseln.png" Width="220"/>
        </Button>

        <Button Command="{Binding HighScorePageCommand}"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,40">
            <Image Source="/images/topspieler.png" Width="220"/>
        </Button>
    </Grid>
</Page>