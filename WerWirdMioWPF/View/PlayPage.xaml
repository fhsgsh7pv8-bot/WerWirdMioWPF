<Page x:Class="WerWirdMioWPF.View.PlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WerWirdMioWPF.View"  
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel" 
      d:DataContext="{d:DesignInstance Type=viewmodel:PlayPageViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="PlayPage">

    <Page.Resources>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <ContentPresenter x:Name="Content">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect x:Name="GlowEffect" BlurRadius="0" ShadowDepth="0" Color="Gold" Opacity="0"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" 
                                                             Storyboard.TargetProperty="(ContentPresenter.Effect).(DropShadowEffect.BlurRadius)" 
                                                             To="30" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Content" 
                                                             Storyboard.TargetProperty="(ContentPresenter.Effect).(DropShadowEffect.Opacity)" 
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" 
                                                             Storyboard.TargetProperty="(ContentPresenter.Effect).(DropShadowEffect.BlurRadius)" 
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Content" 
                                                             Storyboard.TargetProperty="(ContentPresenter.Effect).(DropShadowEffect.Opacity)" 
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Image Source="/images/tikiland.png" Stretch="UniformToFill" />

        <Image Source="/images/coconutgames.png" 
               Width="200" HorizontalAlignment="Left" 
               VerticalAlignment="Top" Margin="30" Height="Auto" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <Image Source="/images/Willkommen.png" Width="600" Height="Auto" />

            <TextBlock Text="" 
                       HorizontalAlignment="Center" 
                       FontSize="70" Foreground="Gold" FontWeight="Bold" Margin="0,20,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <Button Command="{Binding QuestionsPageCommand}"
                    Style="{StaticResource ImageButtonStyle}"
                    Margin="0,50,0,0">
                <Image Source="/images/spielstarten.png" Width="550" Height="Auto"/>
            </Button>
        </StackPanel>

        <Grid VerticalAlignment="Bottom" Margin="50">
            <Button Command="{Binding ChangeUserCommand}"
                    Style="{StaticResource ImageButtonStyle}"
                    HorizontalAlignment="Left">
                <Image Source="/images/benutzerwechseln.png" Width="350" Height="Auto"/>
            </Button>

            <Button Command="{Binding HighScorePageCommand}"
                    Style="{StaticResource ImageButtonStyle}"
                    HorizontalAlignment="Right">
                <Image Source="/images/topspieler.png" Width="350" Height="Auto"/>
            </Button>
        </Grid>
        <Image Margin="130,540,1587,320" 
       Source="/images/tikimensch.png" 
       Stretch="Fill" 
       Opacity="0.15">
            <Image.Effect>
                <DropShadowEffect BlurRadius="15" 
                          ShadowDepth="0" 
                          Color="#00FFCC" Opacity="1"/>
            </Image.Effect>
        </Image>
    </Grid>
</Page>