<Page x:Class="WerWirdMioWPF.View.HighscorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WerWirdMioWPF.View"
      xmlns:viewmodel="clr-namespace:WerWirdMioWPF.ViewModel"
      d:DataContext="{d:DesignInstance Type=viewmodel:HighscorePageViewModel}"
      mc:Ignorable="d" 
        d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Highscores" Background="#1c2042">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Source="/images/highscore.jpg" Stretch="Fill" Grid.RowSpan="2" HorizontalAlignment="Stretch" Height="NaN" VerticalAlignment="Stretch" Width="NaN"/>
        <Button Content="Zurück" Command="{Binding BackCommand}"  HorizontalAlignment="Left" Margin="40,882,0,0" Grid.Row="1" VerticalAlignment="Top" Width="319" Height="133"/>
        <ListView ItemsSource="{Binding TopScores}" Background="Transparent" BorderThickness="0" 
                  Margin="0,268,0,10" Grid.Row="1" HorizontalAlignment="Center" Width="644">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0b132b" BorderBrush="#f1a719" BorderThickness="2" 
                            CornerRadius="10" Margin="0,5" Padding="15,10" Width="380">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Column="0"/>
                            <TextBlock Text="{Binding TotalScore, StringFormat=\{0\} €}" Foreground="#f1a719" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Image Margin="623,0,623,856" Source="/images/Leaderboard.png" Stretch="Fill" Grid.Row="1"/>
        <Image Margin="0,856,1525,41" Source="/images/backspace.png" Stretch="Fill" Grid.Row="1"/>
    </Grid>
</Page>